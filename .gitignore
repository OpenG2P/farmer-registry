/docker/adapters.requirements.txt
/docker/scripts/_service_env.sh
/docker/scripts/.env

# ---------------------------------------------------------------------------
# Helm artifacts
# ---------------------------------------------------------------------------
# Chart.lock is regenerated by `helm dependency update/build`. Because this
# wrapper chart pins to a `-develop` tag of openg2p-registry (an ever-moving
# target), the lock provides no real determinism — leave it untracked.
helm/**/Chart.lock

# Subchart tarballs downloaded by `helm dependency build` into <chart>/charts/.
# Vendored uncompressed subcharts (charts/<name>/) remain tracked.
helm/**/charts/*.tgz
