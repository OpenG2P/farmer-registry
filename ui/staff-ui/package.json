{
  "name": "openg2p-farmer-registry-staff-ui",
  "version": "0.0.0-develop",
  "private": true,
  "description": "Farmer Staff UI — fetch staff-ui from GitHub into .app/; deltas via overrides/.",
  "scripts": {
    "postinstall": "bash ./scripts/materialize-staff-ui.sh && bash ./scripts/ensure-app-deps.sh",
    "reset": "bash ./scripts/reset-app.sh",
    "dev": "bash ./scripts/materialize-staff-ui.sh && bash ./scripts/ensure-app-deps.sh && npm run dev --prefix .app",
    "build": "bash ./scripts/materialize-staff-ui.sh && bash ./scripts/ensure-app-deps.sh && npm run build --prefix .app",
    "start": "bash ./scripts/materialize-staff-ui.sh && bash ./scripts/ensure-app-deps.sh && npm run start --prefix .app"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5"
  }
}
