{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./.app/src/*"],
      "next": ["./.app/node_modules/next"],
      "next/*": ["./.app/node_modules/next/*"],
      "next-intl": ["./.app/node_modules/next-intl"],
      "next-intl/*": ["./.app/node_modules/next-intl/*"],
      "react-toastify": ["./.app/node_modules/react-toastify"],
      "react-toastify/*": ["./.app/node_modules/react-toastify/*"],
      "lucide-react": ["./.app/node_modules/lucide-react"],
      "lucide-react/*": ["./.app/node_modules/lucide-react/*"]
    }
  },
  "include": [
    "overrides/**/*.ts",
    "overrides/**/*.tsx"
  ]
}
